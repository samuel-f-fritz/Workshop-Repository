library(tidyverse)
zero_sims <- data(Count = rpois(50, 5), Type = Poisson)
Poisson_sims <- data(Count = rpois(50, 5), Type = Poisson)
zero_sims <- data.frame(Count = 0, Type = rep("Extra Zero",20))
Poisson_sims <- data.frame(Count = rpois(50, 5), Type = Poisson)
Zero_inflation <- rbind(zero_sims, Poisson_sims)
ggplot(data = Zero_inflation, aes(x = Count, fill = Type))+
geom_histogram()
ggplot(data = Zero_inflation, aes(x = Count, fill = Type))+
geom_histogram()
ggplot(data = Zero_inflation, aes(y = Count, fill = Type))+
geom_histogram()
View(zero_sims)
View(Zero_inflation)
Poisson_sims <- data.frame(Count = rpois(50, 5), Type = Poisson)
Poisson_sims <- data.frame(Count = rpois(50, 5), Type = "Poisson")
Zero_inflation <- rbind(zero_sims, Poisson_sims)
ggplot(data = Zero_inflation, aes(x = Count, fill = Type))+
geom_histogram()
