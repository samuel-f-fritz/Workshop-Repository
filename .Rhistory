## Call packages
library(tidyverse)
## Create master variables
P <- 0.5 # Set the binomial probability
Lambda <- 5## Lambda for rpois
n_total <- 500 ## total number of desired observations.
## Draw binomial probabilities
Zero_Sims <- data.frame(Binomial_hurdle = rbinom(n_total, 1, P))
## Now draw poisson only for the sucessful binomial trials
Zero_Sims$Count <- rpois(n = Zero_Sims$Binomial_hurdle, lambda = Lambda)
View(Zero_Sims)
## Now draw poisson only for the sucessful binomial trials
Zero_Sims$Count <- ifelse(Zero_Sims$Binomial_hurdle > 0, rpois(1, Lambda), 0)
View(Zero_Sims)
## Now draw poisson only for the sucessful binomial trials
Zero_Sims$Count <- ifelse(Zero_Sims$Binomial_hurdle > 0, rpois(0, Lambda), 0)
View(Zero_Sims)
## Now draw poisson only for the sucessful binomial trials
Zero_Sims$Count <- ifelse(Zero_Sims$Binomial_hurdle > 0, rpois(2, Lambda), 0)
View(Zero_Sims)
rpois(2, Lambda)
rpois(2, Lambda)
rpois(2, Lambda)
rpois(2, Lambda)
rpois(2, Lambda)
## Now draw poisson only for the sucessful binomial trials
Zero_Sims$Count <- ifelse(Zero_Sims$Binomial_hurdle > 0, rpois(1, Lambda), 0)
View(Zero_Sims)
## Now draw poisson only for the sucessful binomial trials
Zero_Sims$Count <- ifelse(Zero_Sims$Binomial_hurdle > 0, rpois(Zero_Sims$Binomial_hurdle, Lambda), 0)
View(Zero_Sims)
## Now create a character for underlying process
Zero_Sims <- Zero_Sims %>%
mutate(Type = case_when(
Binomial_hurdle = 0 ~ "Extra Zero",
.default = "Poisson Count"
))
## Now create a character for underlying process
Zero_Sims <- Zero_Sims %>%
mutate(Type = case_when(
Binomial_hurdle == 0 ~ "Extra Zero",
.default = "Poisson Count"
))
## Now create a character for underlying process
Zero_Sims <- Zero_Sims %>%
mutate(Type = case_when(
Binomial_hurdle = 0 ~ "Extra Zero",
.default = "Poisson Count"
))
## Now create a character for underlying process
Zero_Sims <- Zero_Sims %>%
mutate(Type = case_when(
Binomial_hurdle = 0 ~ "Extra Zero",
.default = "Poisson Count"
))
## Now create a character for underlying process
Zero_Sims <- Zero_Sims %>%
mutate(Type = case_when(
Binomial_hurdle = 0 ~ "Extra Zero"
))
## Now create a character for underlying process
Zero_Sims <- Zero_Sims %>%
mutate(Type = case_when(
Binomial_hurdle = 0 ~ "Extra Zero"
))
## Now create a character for underlying process
Zero_Sims <- Zero_Sims %>%
mutate(Type = case_when(
Binomial_hurdle == 0 ~ "Extra Zero"
))
## Now create a character for underlying process
Zero_Sims <- Zero_Sims %>%
mutate(Type = case_when(
Binomial_hurdle == 0 ~ "Extra Zero",
.default = "Poisson Count"
))
View(Zero_Sims)
## Now create a character for underlying process
Zero_Sims <- Zero_Sims %>%
mutate(Type = case_when(
Binomial_hurdle == 0 ~ "Extra Zero",
Binomial_hurdle == 1 ~ "Poisson count"
))
## Graph it
ggplot(data = Zero_Sims, aes(x = Count))+
geom_histogram()
## Graph it without color coding
ggplot(data = Zero_Sims, aes(x = Count))+
geom_histogram()
## Graph with color coding
ggplot(data = Zero_Sims, aes(x = Count, color = Type))+
geom_histogram()
## Graph with color coding
ggplot(data = Zero_Sims, aes(x = Count, fill = Type))+
geom_histogram()
