## Call packages
library(tidyverse)
rpois
## Now draw poisson only for the sucessful binomial trials
Zero_Sims %>%
mutate(Count = case_when(
Binomial_hurdle = 1 ~ rpois(1, Lambda),
.default = 0
))
## Now draw poisson only for the sucessful binomial trials
Zero_Sims %>%
mutate(Count = case_when(
Binomial_hurdle == 1 ~ rpois(1, Lambda),
.default = 0
))
rpois(0,5)
